# =====================================================================
# DINAMO Analytics — configuración del servidor local (copia a .env)
# Este archivo NO lleva secretos. El .env real nunca se sube a GitHub
# (está en .gitignore) y el servidor nunca envía las claves al navegador.
# =====================================================================

# --- Servidor ---------------------------------------------------------
DINAMO_PUERTO=8765
# Sólo cambia DINAMO_HOST si sabes lo que haces; fuera de 127.0.0.1 exige DINAMO_TOKEN.
DINAMO_HOST=127.0.0.1
# Token de acceso (obligatorio si DINAMO_HOST no es local). Abre http://IP:PUERTO/?token=EL_TOKEN
DINAMO_TOKEN=
# Carpeta de conversaciones y archivos subidos (por defecto .dinamo_datos/ dentro del proyecto)
DINAMO_DATOS=
DINAMO_ABRIR_NAVEGADOR=1

# --- Modelo de lenguaje (redacción) ----------------------------------
# auto = Ollama si está abierto; si no, el primer proveedor con clave; si no, la IA del navegador.
DINAMO_LLM=auto
# Local (los datos no salen del equipo):
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=
# Nube (las preguntas y el material relevante SÍ se envían al proveedor):
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODELO=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODELO=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Investigación ---------------------------------------------------
# Tavily funciona sin clave (modo limitado). Con clave gratuita: 1.000 créditos/mes.
TAVILY_API_KEY=
# Opcional: Brave Search. DINAMO_BUSCADOR=brave lo pone primero.
BRAVE_API_KEY=
DINAMO_BUSCADOR=
# Opcional: amplía el límite diario de OpenAlex / Semantic Scholar.
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# Correo de contacto para las APIs académicas ("polite pool" de Crossref/OpenAlex). Opcional.
DINAMO_CORREO_CONTACTO=
